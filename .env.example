# Server-only operator authentication (Preview and Production must be separate).
# TP_AUTH_USERNAME=
# TP_AUTH_PASSWORD_SCRYPT=
# TP_SESSION_SECRET=

# Explicit durable store. No production file-store fallback is permitted.
# TP_OPS_STORE=supabase
# TP_SUPABASE_URL=
# TP_SUPABASE_SECRET_KEY=
# TP_OPS_WORKSPACE=

# Local simulation only, with npm run dev; never a production alternative.
# TP_OPS_LOCAL_ENABLED=true
# TP_OPS_LOCAL_DIRECTORY=

# Test runner ONLY, not application runtime variables. Bind securely outside git.
# PREVIEW_E2E_URL=
# PREVIEW_E2E_DEPLOYMENT_ID=
# PREVIEW_E2E_WORKSPACE=
# PREVIEW_E2E_USERNAME=
# PREVIEW_E2E_PASSWORD=
# VERCEL_AUTOMATION_BYPASS_SECRET=
# PREVIEW_E2E_PERSIST_SYNTHETIC=yes
# PREVIEW_E2E_BACKUP_FILE=

# Add only if your Hilma/API setup requires it.
# HILMA_API_KEY=

# LLM analysis is intentionally not wired into the MVP scaffold yet.
# OPENAI_API_KEY=

# Public sales contact. Configure verified sender and recipient before enabling.
# RESEND_API_KEY=
# URAKKALUOTSI_CONTACT_FROM=
# URAKKALUOTSI_CONTACT_TO=

# Set only when releasing the confirmed public domain.
# URAKKALUOTSI_PUBLIC_ORIGIN=https://urakkaluotsi.fi
